# ---- Supabase / Postgres -------------------------------------------------
# Project Settings -> Database -> Connection string (URI). Use the pooled
# connection (port 6543) for serverless, or 5432 for a long-lived Render service.
DATABASE_URL=postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres

# Optional: Supabase Storage for artifacts (falls back to Postgres if unset)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=pocket-agent

# ---- App -----------------------------------------------------------------
APP_URL=http://localhost:3000
# openssl rand -base64 32
AUTH_SECRET=
MASTER_KEY=
# Optional. The display name is normally set in Settings → Profile.
OWNER_NAME=
# Optional. Leave empty and the first visit to the dashboard asks you to set a
# password (stored as a salted scrypt hash in the database). Set it only if you
# want to manage the password from the environment instead.
OWNER_PASSWORD=
CRON_SECRET=
ALLOW_SIGNUPS=false
DEFAULT_TIMEZONE=Asia/Kolkata

# ---- Agent ---------------------------------------------------------------
AGENT_NAME=Pocket Agent
MAX_STEPS=24
MAX_RUN_TOKENS=120000
DELEGATION_CONCURRENCY=3
LEARNING_ENABLED=true
APPROVAL_MODE=dangerous        # dangerous | writes | never

# ---- Model providers (all optional; configure in UI or here) -------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
ZAI_API_KEY=
OPENROUTER_API_KEY=

# Default role mapping (provider:model). Override in /settings.
LLM_MAIN=openrouter:anthropic/claude-sonnet-4.5
LLM_FAST=openrouter:google/gemini-2.5-flash
LLM_SUMMARY=openrouter:google/gemini-2.5-flash
LLM_VISION=openrouter:google/gemini-2.5-flash
LLM_REVIEW=openrouter:google/gemini-2.5-flash

# ---- Tools ---------------------------------------------------------------
SEARCH_PROVIDER=none           # none | tavily | brave | searxng
SEARCH_API_KEY=
SEARXNG_URL=
EXEC_BACKEND=disabled          # disabled | local
EXEC_ALLOWLIST=                # comma separated binaries, e.g. ls,cat,node,pnpm
HTTP_ALLOWLIST=                # comma separated hosts for http_request

# ---- Chat channels -------------------------------------------------------
# Optional. Settings → Channels in the UI is the normal way to configure
# these; the variables below are only a fallback for headless deployments.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ALLOWED_USER_IDS=
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
DISCORD_ALLOWED_USER_IDS=
